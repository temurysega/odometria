<?xml version="1.0"?>
<package format="3">
  <name>odometria</name>
  <version>1.0.0</version>
  <description>Резервная одометрия трамвая: нелинейная модель тягового привода, наблюдатель скорости с обработкой проскальзывания, привязка к карте пути по местам остановок.</description>
  <maintainer email="temurysega@users.noreply.github.com">temurysega</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tram_vehicle_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
